# Copy to `.env.local` and fill in real values.
# `.env*` is gitignored, so your credentials will never be committed.

# --- SMTP (delivers contact-form enquiries to Saharahomehealthcareservice@gmail.com) ---
# Provider examples:
#   Gmail / Google Workspace : SMTP_HOST=smtp.gmail.com        SMTP_PORT=465
#   GoDaddy / Workspace Email: SMTP_HOST=smtpout.secureserver.net SMTP_PORT=465
#   Brevo / SendGrid          : SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587
#
# Gmail requires an App Password (not your account password):
#   https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional — the "From" header. Defaults to SMTP_USER if left blank.
SMTP_FROM="Sahara Home Health Care <Saharahomehealthcareservice@gmail.com>"